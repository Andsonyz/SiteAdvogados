{
  "name": "iara-santos-advocacia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/vite.mjs dev --host 127.0.0.1",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/vite.mjs build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:assets": "node --test tests/brand-assets.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "verify:dev": "playwright test --config playwright.runtime.config.ts",
    "verify": "npm run doctor && npm run test:runtime && npm run verify:dev && npm run build && npm run test:assets && playwright test --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/baskervville": "5.3.0",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
